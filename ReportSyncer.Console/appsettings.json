{
  "run": {
    "jobConfigPath": "job.yaml",
    "dryRun": false
  },
  "ui": {
    "enabled": true,
    "areaC": {
      "maxLines": 200
    }
  },
  "logging": {
    "file": {
      "enabled": true,
      "directory": "logs",
      "fileNamePrefix": "reportsyncer",
      "retentionCount": 20
    },
    "ring": {
      "enabled": true,
      "capacity": 2000,
      "minLevel": "Information"
    },
    "console": {
      "enabled": false,
      "minLevel": "Information"
    },
    "progressThrottleMs": 5000
  }
}
