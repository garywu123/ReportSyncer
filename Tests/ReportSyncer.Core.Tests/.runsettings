<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <ResultsDirectory>TestResults</ResultsDirectory>
    <TargetPlatform>x64</TargetPlatform>
    <EnvironmentVariables>
      <!-- Replace value with your SQL Server base connection (no Initial Catalog) -->
      <REPORTSYNCER_TEST_SQL_CONN>Server=(localdb)\MSSQLLocalDB;Integrated Security=true</REPORTSYNCER_TEST_SQL_CONN>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>